#!/usr/bin/env python3
"""Capture a thought into the vault, with no model anywhere on the path.

    capture "the friction is naming it, not typing it"
    echo "..." | capture
    capture --json --source nvim "..."
    capture --dry-run "..."

Prints the path it wrote to stdout and nothing else, so the callers (a
Hammerspoon toast, a Raycast confirmation, a Neovim `:Capture`) can show where
the thought landed. Anything meant for a human goes to stderr.
"""

import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path

# resolve() rather than a bare dirname: the installed entry point is a symlink
# at ~/bin/capture, so __file__ points at the link and the sibling lib/ would
# not be found from there.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import capture_core  # noqa: E402  (path shim above has to come first)

# Same names and order as lua/util/vault.lua in the nvim config, so the two
# resolvers cannot disagree about where the vault is.
VAULT_VARS = ("OBSIDIAN_VAULT", "OBSIDIAN_VAULT_PATH")


def resolve_vault(explicit):
    """Vault root from --vault, else the environment. Never a guessed default.

    lua/util/vault.lua falls back to ~/Thoughts, which is right for a reader:
    the worst case is opening the wrong file. A writer with the same fallback
    would create ~/Thoughts/00-Capture on a machine whose vault lives elsewhere
    and the thought would be saved somewhere the user never looks -- a silent
    loss, which is worse than a refusal.
    """
    if explicit:
        return Path(explicit).expanduser()
    for name in VAULT_VARS:
        value = os.environ.get(name)
        if value:
            return Path(value).expanduser()
    raise SystemExit(
        "capture: $OBSIDIAN_VAULT is not set, so there is nowhere safe to write.\n"
        "         Set it (bash/local/bash_settings_local) or pass --vault DIR."
    )


def read_text(words):
    """Text from argv, else stdin when it is a pipe rather than a terminal."""
    if words:
        return " ".join(words)
    if not sys.stdin.isatty():
        return sys.stdin.read()
    return ""


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="capture",
        description="Append a thought to the vault's capture folder.",
    )
    parser.add_argument("text", nargs="*", help="the thought; omit to read stdin")
    parser.add_argument(
        "--source",
        default="shell",
        help="which door this came from, recorded in frontmatter (default: shell)",
    )
    parser.add_argument("--vault", help="vault root, overriding $OBSIDIAN_VAULT")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the path that would be written, and write nothing",
    )
    parser.add_argument(
        "--json",
        dest="as_json",
        action="store_true",
        help="emit a JSON object instead of a bare path",
    )
    args = parser.parse_args(argv)

    text = read_text(args.text).strip()
    if not text:
        raise SystemExit("capture: nothing to capture (no text given, no stdin)")

    vault = resolve_vault(args.vault)
    now = datetime.now().astimezone()

    try:
        if args.dry_run:
            path = capture_core.planned_path(text, vault, now)
        else:
            path = capture_core.write(text, vault, now, source=args.source)
    except (OSError, ValueError, RuntimeError) as failure:
        raise SystemExit("capture: {}".format(failure))

    try:
        link = capture_core.deeplink(path, vault)
    except ValueError:
        link = None

    if args.as_json:
        print(
            json.dumps(
                {
                    "path": str(path),
                    "slug": capture_core.slug(text),
                    "created_at": now.isoformat(timespec="seconds"),
                    "source": args.source,
                    "written": not args.dry_run,
                    "deeplink": link,
                    "first_line": text.split("\n", 1)[0].strip(),
                },
                ensure_ascii=False,
            )
        )
    else:
        # Deliberately still the bare path, and nothing else. The Neovim door
        # reads this whole line as a filename and the Raycast door strips it to
        # a basename, so adding the URI here would break both.
        print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
